# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.

# So bekommst du eine Webhook-URL: Discord-Server -> Kanal-Einstellungen ->
# Integrationen -> Webhooks -> Neuer Webhook -> "Webhook-URL kopieren"
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/DEINE_WEBHOOK_ID/DEIN_WEBHOOK_TOKEN

# Optional: Google-Gemini API-Key (kostenloser Free-Tier) fuer die
# KI-Zustandsbewertung der Angebote.
# Erstellen unter https://aistudio.google.com/app/apikey -> "Create API key"
# (siehe README fuer die Schritt-fuer-Schritt-Anleitung). Ohne diesen Key
# stuft der Tracker Angebote nur anhand des Preises ein (kein Fehler).
GEMINI_API_KEY=DEIN-GEMINI-KEY-HIER

# --- Discord-Bot (Interactions-Endpoint, /track /untrack /list /deals) ---
# Discord Developer Portal -> deine App -> "General Information"
DISCORD_APP_ID=DEINE_APPLICATION_ID
DISCORD_PUBLIC_KEY=DEIN_PUBLIC_KEY
# "Bot" -> "Reset Token". NUR fuer scripts/register_commands.py noetig.
# Wie ein Passwort behandeln, niemals committen/teilen.
DISCORD_BOT_TOKEN=DEIN_BOT_TOKEN
# Rechtsklick auf den Server (Entwicklermodus an) -> "Server-ID kopieren"
DISCORD_GUILD_ID=DEINE_SERVER_ID

# --- Supabase (geteilte Produkt-Datenbank) ---
# supabase.com -> Projekt anlegen -> Project Settings -> API
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_KEY=DEIN_SERVICE_ROLE_KEY

# --- GitHub (fuer /track: loest einen Scrape-Lauf per workflow_dispatch aus) ---
# github.com/settings/personal-access-tokens/new -> Fine-grained, nur dieses
# Repo, Rechte: Actions=Read/Write, Contents=Read-only, Metadata=Read-only
GH_DISPATCH_TOKEN=DEIN_FEINGRANULARER_PAT
GH_REPO=xertyyy/macbook-price-tracker
